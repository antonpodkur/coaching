  "query": "SELECT s.id, s.workout_exercise_id, s.target_kg::float8 AS kg,\n                  s.target_reps_min, s.target_reps_max\n           FROM workout_sets s\n           JOIN workout_exercises we ON we.id = s.workout_exercise_id\n           WHERE we.workout_id = $1\n           ORDER BY s.position",
