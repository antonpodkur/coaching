# Copy to backend/.env for local development.
DATABASE_URL=postgres://coaching:coaching@localhost:5434/coaching
BIND_ADDR=127.0.0.1:8080
# Token and username (without @) of the *dev* bot from @BotFather. Never the production bot.
BOT_TOKEN=
BOT_USERNAME=
# Telegram echoes it in every webhook call; `openssl rand -hex 24`.
WEBHOOK_SECRET=
# https://<tunnel>/api/telegram/webhook registers the webhook on startup; empty skips it.
# On Render it defaults to $RENDER_EXTERNAL_URL/telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# Your numeric Telegram ID makes you the coach on startup (the bot logs it when you send /start).
COACH_TELEGRAM_ID=
# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Where the frontend is served: allowed by CORS and used for the bot's buttons.
# In development, the tunnel URL (Telegram buttons need HTTPS).
FRONTEND_ORIGIN=http://localhost:5173
RUST_LOG=coaching_backend=debug,tower_http=info
# Bunny Stream (exercise videos). Leave BUNNY_STREAM_LIBRARY_ID empty to run without video uploads.
# All four are on the library's page in Bunny: Stream > library > API.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Bunny signs webhooks with it; when set, unsigned webhooks are refused.
BUNNY_STREAM_READ_ONLY_API_KEY=
# The library's CDN hostname, e.g. vz-1234abcd-567.b-cdn.net
BUNNY_CDN_HOSTNAME=
# A second, private library for clients' technique videos. Leave the ID empty to turn them off.
# Its CDN must have token authentication on; the token key signs every playback link.
BUNNY_CLIENT_LIBRARY_ID=
BUNNY_CLIENT_API_KEY=
BUNNY_CLIENT_READ_ONLY_API_KEY=
BUNNY_CLIENT_CDN_HOSTNAME=
BUNNY_CLIENT_TOKEN_KEY=

# A private Bunny Storage zone for photos (clients' gyms). Leave the zone empty to turn photos off.
# Its pull zone must have token authentication on; the token key signs every photo link.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_CDN_HOSTNAME=
BUNNY_STORAGE_TOKEN_KEY=

# Signs notifications from the installed app (web push). `cargo run --bin vapid-key`
# makes one; leave it empty to run without them.
VAPID_PRIVATE_KEY=
