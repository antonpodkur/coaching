# Copy to backend/.env for local development.
DATABASE_URL=postgres://coaching:coaching@localhost:5434/coaching
BIND_ADDR=127.0.0.1:8080
# Token and username (without @) of the *dev* bot from @BotFather. Never the production bot.
BOT_TOKEN=
BOT_USERNAME=
# Telegram echoes it in every webhook call; `openssl rand -hex 24`.
WEBHOOK_SECRET=
# https://<tunnel>/api/telegram/webhook registers the webhook on startup; empty skips it.
TELEGRAM_WEBHOOK_URL=
# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Where the frontend is served: allowed by CORS and used for the bot's buttons.
# In development, the tunnel URL (Telegram buttons need HTTPS).
FRONTEND_ORIGIN=http://localhost:5173
RUST_LOG=coaching_backend=debug,tower_http=info
# Bunny Stream (exercise videos). Leave BUNNY_STREAM_LIBRARY_ID empty to run without video uploads.
# All four are on the library's page in Bunny: Stream > library > API.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Bunny signs webhooks with it; when set, unsigned webhooks are refused.
BUNNY_STREAM_READ_ONLY_API_KEY=
# The library's CDN hostname, e.g. vz-1234abcd-567.b-cdn.net
BUNNY_CDN_HOSTNAME=
