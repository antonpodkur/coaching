# Copy to backend/.env for local development.
DATABASE_URL=postgres://coaching:coaching@localhost:5434/coaching
BIND_ADDR=127.0.0.1:8080
# Token and username (without @) of the *dev* bot from @BotFather. Never the production bot.
BOT_TOKEN=
BOT_USERNAME=
# Telegram echoes it in every webhook call; `openssl rand -hex 24`.
WEBHOOK_SECRET=
# https://<tunnel>/api/telegram/webhook registers the webhook on startup; empty skips it.
TELEGRAM_WEBHOOK_URL=
# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Where the frontend is served: allowed by CORS and used for the bot's buttons.
# In development, the tunnel URL (Telegram buttons need HTTPS).
FRONTEND_ORIGIN=http://localhost:5173
RUST_LOG=coaching_backend=debug,tower_http=info
