# Copy to backend/.env for local development.
DATABASE_URL=postgres://coaching:coaching@localhost:5434/coaching
BIND_ADDR=127.0.0.1:8080
# Token of the *dev* bot from @BotFather. Never the production bot.
BOT_TOKEN=
# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Origin allowed by CORS: the Vite dev server or the tunnel in front of it.
FRONTEND_ORIGIN=http://localhost:5173
RUST_LOG=coaching_backend=debug,tower_http=info
